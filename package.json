{
  "name": "flagsweep",
  "version": "0.1.0",
  "description": "Find stale feature flags and remove them from React/TypeScript code with safe codemods.",
  "type": "module",
  "bin": {
    "flagsweep": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "commander": "^15.0.0",
    "prettier": "^3.9.10",
    "ts-morph": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rahulcs754/flagsweep.git"
  },
  "homepage": "https://github.com/rahulcs754/flagsweep#readme",
  "bugs": {
    "url": "https://github.com/rahulcs754/flagsweep/issues"
  },
  "keywords": [
    "feature-flags",
    "codemod",
    "ts-morph",
    "react",
    "typescript",
    "posthog",
    "tech-debt",
    "cli"
  ],
  "author": "rahulcs754"
}
